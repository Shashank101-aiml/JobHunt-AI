# Job Hunt Environment Configuration
# Copy this file to .env and configure your local or production settings.

# Database Configuration (PostgreSQL or SQLite for local dev)
# For PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobhunt
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobhunt
# For local SQLite dev/testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./jobhunt.db
# SYNC_DATABASE_URL=sqlite:///./jobhunt.db

# Redis Configuration (Celery broker & backend)
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration ("anthropic", "openai", or "none")
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-haiku-20240307

# ChromaDB Vector Store Persistence
CHROMA_PERSIST_DIR=./chroma_db

# Email Notification / Follow-up Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
FROM_EMAIL=agent@jobhunt.ai
EMAIL_ENABLED=false

# Job Scraper & Browser Automation
ENABLE_PLAYWRIGHT=false
SCRAPER_TIMEOUT_SECONDS=15

# Candidate Defaults (Used for review packages and templates)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
